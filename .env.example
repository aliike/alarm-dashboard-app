# AWS Configuration
# Gerekli değil — uygulama EC2 Instance Profile'ı otomatik kullanır.
# Lokal test için uncomment et:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Database
# SQLite dosyasının yolu (Docker volume mount ile eşleşmeli)
# DATABASE_PATH=/data/alarm_dashboard.db

# Application
# LOG_LEVEL=info
